    print ("kategori : ", kategori)
    

    total_nilai = total_nilai + nilai_akhir
    rata_rata = total_nilai / 3

    if nilai_akhir > nilai_tertinggi:
        nilai_tertinggi = nilai_akhir
        nama_tertinggi = nama
    else:
        if nilai_terendah == 0:
            nilai_terendah = nilai_akhir
        elif nilai_akhir < nilai_terendah:
            nilai_terendah = nilai_akhir
            nama_terendah = nama


