nama_tertinggi = ""
nama_terendah = ""

for i in range (3): 
    print("mahasiswa ke- ", i + 1)
    nama = input ("Masukkan nama : ")
    tugas = int(input("Masukkan nilai tugas : "))
    uts = int(input("Masukkan nilai UTS: "))
    uas = int(input("Masukkan nilai UAS: "))
    

    nilai_akhir = (tugas * 0.30) + (uts * 0.30) + (uas * 0.40)

    if nilai_akhir >= 85:
        kategori = "A"
        A = A + 1
    
        
    elif nilai_akhir >= 75:
        kategori = "B"
        B = B + 1
        
       
    elif nilai_akhir >= 65:
        kategori = "C"
        C = C + 1
    
        
    elif nilai_akhir >= 50:
        kategori = "D"
        D = D + 1
       
       
    else :
        kategori = "E"
        E = E + 1

    print("nama : ", nama)
