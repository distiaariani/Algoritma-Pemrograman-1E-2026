<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="soal 1 modul 2"/>
        <attribute name="authors" value="disti"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-04 08:22:09 PM"/>
        <attribute name="created" value="ZGlzdGk7TEFQVE9QLTUwQkNLMFRIOzIwMjYtMTAtMDQ7MDM6NDA6MzUgUE07MjgzNw=="/>
        <attribute name="edited" value="ZGlzdGk7TEFQVE9QLTUwQkNLMFRIOzIwMjYtMTAtMDQ7MDg6MjI6MDkgUE07MTsyOTUx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, digit1, digit2, digit3, pelacak, pelacaktahap1, pelacaktahap2" type="Integer" array="False" size=""/>
            <declare name="status" type="String" array="False" size=""/>
            <input variable="kode"/>
            <assign variable="digit1" expression="kode / 100"/>
            <assign variable="digit2" expression="(kode / 10) % 10"/>
            <assign variable="digit3" expression="kode % 10"/>
            <assign variable="pelacak" expression="digit1 * digit3"/>
            <if expression="digit2 % 2 == 1">
                <then>
                    <assign variable="pelacaktahap1" expression="pelacak + 25"/>
                </then>
                <else>
                    <assign variable="pelacaktahap1" expression="pelacak - digit2"/>
                </else>
            </if>
            <if expression="pelacaktahap1 % 3 == 0">
                <then>
                    <assign variable="pelacaktahap2" expression="pelacaktahap1 / 3"/>
                </then>
                <else>
                    <assign variable="pelacaktahap2" expression="pelacaktahap1 *  2"/>
                </else>
            </if>
            <if expression="pelacaktahap2 &gt; 50">
                <then>
                    <assign variable="status" expression="&quot;Kategori A&quot;"/>
                </then>
                <else>
                    <if expression="pelacaktahap2 &gt; 20">
                        <then>
                            <assign variable="status" expression="&quot;Kategori B&quot;"/>
                        </then>
                        <else>
                            <assign variable="status" expression="&quot;Password Ditolak&quot;"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Digit 1: &quot; &amp; digit1" newline="True"/>
            <output expression="&quot;Digit 2: &quot; &amp; digit2" newline="True"/>
            <output expression="&quot;Digit 3: &quot; &amp; digit3" newline="True"/>
            <output expression="&quot;Pelacak Awal: &quot; &amp; pelacak" newline="True"/>
            <output expression="&quot;pelacak Tahap 1: &quot; &amp; pelacaktahap1" newline="True"/>
            <output expression="&quot;Pelacak Tahap 2: &quot; &amp; pelacaktahap2" newline="True"/>
            <output expression="&quot;Status Password: &quot; &amp; status" newline="True"/>
        </body>
    </function>
</flowgorithm>
